# ==========================================
# HARSH APEX SMART BUSINESS SUITE - ENV CONFIG
# Copy this file to .env.local for local development
# ==========================================

# ── Application URL ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase Credentials ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── PostgreSQL Direct Connection (REQUIRED for Vercel production) ──────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use "Transaction" mode URL (port 6543) for Vercel serverless
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── AI Provider (SERVER-SIDE ONLY — never use NEXT_PUBLIC_) ───────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Demo Mode (set to false in production) ────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true

# ── Optional Integrations (leave blank to use simulation mode) ────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
