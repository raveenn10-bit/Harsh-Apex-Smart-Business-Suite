# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Direct PostgreSQL Connection (Optional for direct migrations)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Demo Mode & Local Engine Fallback (Enabled for standalone local demo execution without live Supabase cloud keys)
NEXT_PUBLIC_DEMO_MODE=true

# Future Integration Ready (Leave blank for simulation mode)
OPENAI_API_KEY=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
